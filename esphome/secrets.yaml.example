# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "YOUR_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Optional. Pins the panel to the 2.4 GHz radio of a dual-band SSID, which avoids
# it hunting for a 5 GHz BSSID it cannot use. Delete this line AND the bssid line
# in esphome/base/network.yaml if you do not want it.
wifi_bssid_24ghz: "00:00:00:00:00:00"

ap_password: "FALLBACK_AP_PASSWORD_8_CHARS_MIN"
api_key: "RUN: openssl rand -base64 32"
ota_password: "ANY_PASSPHRASE"
